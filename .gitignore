# IDE / OS
.idea/
.DS_Store
*.swp
*.swo
*~

# Local developer preferences (not tracked)
.vscode/.aws_profile
.claude/settings.local.json

# Temporary PR/MR description files (not tracked)
.github/pr-descriptions/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.cover
coverage.xml

# Poetry
poetry.lock
.poetry/
requirements.txt
requirements-dev.txt

# Node
node_modules/

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# Docker
*.log

# dbt
dbt_packages/
dbt_internal_packages/
target/
dbt_modules/
logs/
*.manifest.json
*.catalog.json
temp/
scripts/
# ...but Claude Code skill scripts are tracked
!.claude/skills/**/scripts/
!.claude/skills/**/scripts/**
# ...except compiled Python artifacts inside them
.claude/skills/**/scripts/**/__pycache__/
.claude/skills/**/scripts/**/*.py[cod]

# Jupyter
.ipynb_checkpoints/

# PR descriptions (keep folder, ignore content)
.github/pr-descriptions/*
!.github/pr-descriptions/.gitkeep
